<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Validates Assets/Resources/Content/*.csv without opening Unity.
    It compiles the same pure C# files the game uses, so the parser, the format and
    the rules cannot drift between the game and this check.

    Usage (from the repo root): dotnet run project tools/content-check
    Pass the write flag as the only argument to normalise the files in place.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>content-check</AssemblyName>
    <RootNamespace>Prototype.Tools</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Assets\Scripts\Content\Csv.cs" />
    <Compile Include="..\..\Assets\Scripts\Content\ContentCsv.cs" />
    <Compile Include="..\..\Assets\Scripts\Data\CardData.cs" />
    <Compile Include="..\..\Assets\Scripts\Data\EnemyData.cs" />
    <Compile Include="..\..\Assets\Scripts\Data\RelicData.cs" />
    <Compile Include="..\..\Assets\Scripts\Data\EventData.cs" />
  </ItemGroup>
</Project>
